# Copy to .env.local (or .env) and fill in. If both exist, .env.local wins.

# Required to create/update the agent, and used server-side to mint a
# conversation token so the key never reaches the browser.
ELEVENLABS_API_KEY=

# Filled in automatically by `npm run setup-agent`.
ELEVENLABS_AGENT_ID=

# Optional: pick a voice. Leave blank to use the agent's default.
ELEVENLABS_VOICE_ID=

# Optional: override the agent's LLM, e.g. gemini-2.5-flash or gpt-4o.
# Leave blank to use the ElevenLabs default.
AGENT_LLM=

# Optional: port for the local server.
PORT=5173
